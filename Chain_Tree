from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor, ColorSensor, UltrasonicSensor, ForceSensor
from pybricks.parameters import Button, Color, Direction, Port, Side, Stop
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch

hub = PrimeHub()

left_drive = Motor(Port.D, Direction.COUNTERCLOCKWISE)
right_drive = Motor(Port.C,Direction.CLOCKWISE)  
robot = DriveBase(left_drive,right_drive,88,127)  
left_motor = Motor(Port.B, Direction.CLOCKWISE)  
right_motor = Motor(Port.A, Direction.COUNTERCLOCKWISE)  
robot.settings(300,300,200,200)  
robot.use_gyro(False) 
#sensor = ColorSensor(Port.E)
#button = ForceSensor(Port.F)

robot.straight(350)
right_motor.run_angle(100,-20, Stop.HOLD, False)
left_motor.run_angle(100,-20)
robot.straight(-150)
robot.turn(15)
wait(100)
right_motor.run_angle(-100,-70, Stop.HOLD, False)
left_motor.run_angle(-100,-70)
robot.turn(20, Stop.HOLD, False)
robot.straight(-30)
robot.straight(-120)
